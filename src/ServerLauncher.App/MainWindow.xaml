<Window x:Class="ServerLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ServerLauncher.App.Views"
        xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
        Title="Server Launcher"
        Height="760" Width="1180"
        MinHeight="520" MinWidth="900"
        Background="{StaticResource Bg.Window}"
        Icon="Assets/app.ico"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <views:StateToBrushConverter x:Key="StateToBrush" />
        <views:LogStreamToBrushConverter x:Key="StreamToBrush" />
        <views:NullToVisibilityConverter x:Key="NullToVisibility" />
        <views:NotNullToBoolConverter x:Key="NotNullToBool" />
        <views:EmptyToPlaceholderConverter x:Key="EmptyToPlaceholder" />
        <views:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Tray icon: the app keeps supervising servers while the window is hidden. -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        IconSource="Assets/app.ico"
                        ToolTipText="Server Launcher"
                        NoLeftClickDelay="True"
                        TrayLeftMouseUp="OnTrayLeftClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Open Server Launcher" Click="OnTrayOpen" FontWeight="SemiBold" />
                    <Separator />
                    <MenuItem x:Name="TrayServersMenu" Header="Servers" />
                    <Separator />
                    <MenuItem Header="Exit" Click="OnTrayExit" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource Bg.Panel}"
                BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,0,0,1"
                Padding="12,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="Server Launcher"
                           FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="2,0,20,0" />

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Settings" Style="{StaticResource ToolButton}"
                            Command="{Binding OpenSettingsCommand}" Margin="0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Button Content="▶  Start" Style="{StaticResource PrimaryButton}"
                            Command="{Binding StartCommand}"
                            IsEnabled="{Binding SelectedServer.CanStart, FallbackValue=False}" />
                    <Button Content="■  Stop" Style="{StaticResource ToolButton}"
                            Command="{Binding StopCommand}"
                            IsEnabled="{Binding SelectedServer.CanStop, FallbackValue=False}" />
                    <Button Content="⟳  Restart" Style="{StaticResource ToolButton}"
                            Command="{Binding RestartCommand}"
                            IsEnabled="{Binding SelectedServer.CanStop, FallbackValue=False}" />
                    <Rectangle Width="1" Fill="{StaticResource Border.Subtle}" Margin="6,2,12,2" />
                    <Button Content="Add server" Style="{StaticResource ToolButton}"
                            Command="{Binding AddServerCommand}" />
                    <Button Content="Edit" Style="{StaticResource ToolButton}"
                            Command="{Binding EditServerCommand}"
                            IsEnabled="{Binding SelectedServer, Converter={StaticResource NotNullToBool}, FallbackValue=False}" />
                    <Button Content="Remove" Style="{StaticResource ToolButton}"
                            Command="{Binding RemoveServerCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Update banner -->
        <Border Grid.Row="1"
                Background="{StaticResource Accent}"
                Padding="14,10"
                Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                        <Button Content="Release notes" Style="{StaticResource ToolButton}"
                                Command="{Binding ViewReleaseNotesCommand}" Padding="10,4" />
                        <Button Content="Later" Style="{StaticResource ToolButton}"
                                Command="{Binding DismissUpdateCommand}" Padding="10,4" />
                        <Button Content="Install and restart" Style="{StaticResource ToolButton}"
                                Command="{Binding InstallUpdateCommand}" Padding="10,4" Margin="0" />
                    </StackPanel>

                    <TextBlock Text="{Binding UpdateBannerText}" VerticalAlignment="Center"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <StackPanel Grid.Row="1" Margin="0,8,0,0"
                            Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding UpdateProgressText}" FontSize="11.5" Margin="0,0,0,4" />
                    <ProgressBar Value="{Binding UpdateProgress}" Maximum="100" Height="4" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <!-- Server list -->
            <Border Grid.Column="0" Background="{StaticResource Bg.Panel}">
                <Grid>
                    <ListBox ItemsSource="{Binding Servers}"
                             SelectedItem="{Binding SelectedServer}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,8" />
                                <Setter Property="Foreground" Value="{StaticResource Fg.Primary}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Root" Background="Transparent"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="Background"
                                                            Value="{StaticResource Bg.Hover}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Root" Property="Background"
                                                            Value="{StaticResource Bg.Selected}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Ellipse Grid.Column="0" Width="9" Height="9"
                                             Margin="0,0,9,0" VerticalAlignment="Center"
                                             Fill="{Binding State, Converter={StaticResource StateToBrush}}" />

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                   Foreground="{StaticResource Fg.Secondary}" />
                                        <TextBlock Text="{Binding ResourceSummary}" FontSize="11"
                                                   Foreground="{StaticResource Fg.Muted}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty state -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20"
                                Visibility="{Binding HasServers, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                        <TextBlock Text="No servers yet" HorizontalAlignment="Center"
                                   Foreground="{StaticResource Fg.Secondary}" />
                        <TextBlock Text="Add a .bat or .ps1 that starts your server."
                                   Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,6,0,10" />
                        <Button Content="Add server" Style="{StaticResource PrimaryButton}"
                                Command="{Binding AddServerCommand}" HorizontalAlignment="Center" Margin="0" />
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Stretch"
                          Background="{StaticResource Border.Subtle}" />

            <!-- Detail -->
            <Grid Grid.Column="2" Visibility="{Binding SelectedServer, Converter={StaticResource NullToVisibility}}">
                <TabControl Margin="0">
                    <!-- Console -->
                    <TabItem Header="Console">
                        <Grid Background="{StaticResource Bg.Panel}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,8">
                                <CheckBox Content="Auto-scroll" IsChecked="{Binding AutoScroll}"
                                          VerticalAlignment="Center" Margin="0,0,14,0" />
                                <Button Content="Clear" Style="{StaticResource ToolButton}"
                                        Command="{Binding ClearConsoleCommand}" Padding="10,4" />
                                <Button Content="Open log folder" Style="{StaticResource ToolButton}"
                                        Command="{Binding OpenLogFolderCommand}" Padding="10,4" />
                                <Button Content="Open server folder" Style="{StaticResource ToolButton}"
                                        Command="{Binding OpenServerFolderCommand}" Padding="10,4" />
                            </StackPanel>

                            <Border Grid.Row="1" Background="{StaticResource Bg.Console}" Margin="10,0,10,0">
                                <ListBox x:Name="ConsoleList"
                                         ItemsSource="{Binding SelectedServer.ConsoleLines}"
                                         Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         VirtualizingStackPanel.IsVirtualizing="True"
                                         VirtualizingStackPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="6,1">
                                                <TextBlock Text="{Binding Timestamp}"
                                                           FontFamily="{StaticResource Font.Mono}"
                                                           FontSize="11.5"
                                                           Foreground="{StaticResource Fg.Muted}"
                                                           Margin="0,0,10,0" />
                                                <TextBlock Text="{Binding Text}"
                                                           FontFamily="{StaticResource Font.Mono}"
                                                           FontSize="11.5"
                                                           TextWrapping="NoWrap"
                                                           Foreground="{Binding Stream, Converter={StaticResource StreamToBrush}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <Grid Grid.Row="2" Margin="10,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CommandBox" Grid.Column="0"
                                         Text="{Binding CommandInput, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{StaticResource Font.Mono}"
                                         KeyDown="OnCommandBoxKeyDown"
                                         IsEnabled="{Binding SelectedServer.IsRunning, FallbackValue=False}"
                                         Padding="8,6" />
                                <Button Grid.Column="1" Content="Send" Style="{StaticResource ToolButton}"
                                        Command="{Binding SendCommandCommand}" Margin="6,0,0,0"
                                        IsEnabled="{Binding SelectedServer.IsRunning, FallbackValue=False}" />
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- Monitoring -->
                    <TabItem Header="Monitoring">
                        <Grid Background="{StaticResource Bg.Panel}">
                            <StackPanel Margin="20">
                                <TextBlock Text="Resource usage" Style="{StaticResource SectionHeading}" Margin="0,0,0,10" />

                                <UniformGrid Columns="4" Margin="0,0,0,20">
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="CPU" Style="{StaticResource Label}" Margin="0,0,0,2" />
                                        <TextBlock FontSize="22"
                                                   Text="{Binding SelectedServer.CpuPercent, StringFormat={}{0:0.0}%}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Memory" Style="{StaticResource Label}" Margin="0,0,0,2" />
                                        <TextBlock FontSize="22"
                                                   Text="{Binding SelectedServer.MemoryMegabytes, StringFormat={}{0:0} MB}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Uptime" Style="{StaticResource Label}" Margin="0,0,0,2" />
                                        <TextBlock FontSize="22" Text="{Binding SelectedServer.UptimeText}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Processes" Style="{StaticResource Label}" Margin="0,0,0,2" />
                                        <TextBlock FontSize="22" Text="{Binding SelectedServer.ProcessCount}" />
                                    </StackPanel>
                                </UniformGrid>

                                <TextBlock Text="CPU history (last 2 minutes)" Style="{StaticResource Label}" />
                                <Border Background="{StaticResource Bg.Console}"
                                        BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1"
                                        Height="130" Padding="8">
                                    <views:Sparkline Values="{Binding SelectedServer.CpuHistory}"
                                                     Maximum="100"
                                                     Stroke="{StaticResource Accent}" />
                                </Border>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Measured across the server's whole process tree, so a .bat that launches Java reports the Java process too." />
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <!-- Backups -->
                    <TabItem Header="Backups">
                        <Grid Background="{StaticResource Bg.Panel}">
                            <StackPanel Margin="20">
                                <TextBlock Text="Backups" Style="{StaticResource SectionHeading}" Margin="0,0,0,6" />

                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14"
                                           Text="Safe mode stops the server, archives it, then restarts it — always consistent, with a short outage. Live mode archives while running and skips any files the server holds locked." />

                                <TextBlock Text="Source folder" Style="{StaticResource Label}" />
                                <TextBlock Text="{Binding SelectedServer.Definition.BackupSourceFolder, Converter={StaticResource EmptyToPlaceholder}, ConverterParameter='(working directory)'}"
                                           FontFamily="{StaticResource Font.Mono}" FontSize="11.5" TextWrapping="Wrap" />

                                <TextBlock Text="Destination folder" Style="{StaticResource Label}" />
                                <TextBlock Text="{Binding SelectedServer.Definition.BackupDestinationFolder, Converter={StaticResource EmptyToPlaceholder}, ConverterParameter='(not set)'}"
                                           FontFamily="{StaticResource Font.Mono}" FontSize="11.5" TextWrapping="Wrap" />

                                <TextBlock Text="Mode" Style="{StaticResource Label}" />
                                <TextBlock Text="{Binding SelectedServer.Definition.BackupMode}" />

                                <TextBlock Text="Schedule" Style="{StaticResource Label}" />
                                <TextBlock Text="{Binding SelectedServer.Definition.BackupScheduleTime, Converter={StaticResource EmptyToPlaceholder}, ConverterParameter='(manual only)'}" />

                                <TextBlock Text="Archives kept" Style="{StaticResource Label}" />
                                <TextBlock Text="{Binding SelectedServer.Definition.BackupRetentionCount}" />

                                <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                                    <Button Content="Back up now" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding RunBackupCommand}" />
                                    <Button Content="Edit backup settings" Style="{StaticResource ToolButton}"
                                            Command="{Binding EditServerCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="3" Background="{StaticResource Bg.Panel}"
                BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,1,0,0"
                Padding="12,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentVersionText}" FontSize="11.5"
                               Foreground="{StaticResource Fg.Muted}" VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <Button Content="Check for updates" Style="{StaticResource ToolButton}"
                            Command="{Binding CheckForUpdatesManuallyCommand}"
                            Padding="8,2" Margin="0" FontSize="11" />
                </StackPanel>

                <TextBlock Text="{Binding StatusMessage}" FontSize="11.5" VerticalAlignment="Center"
                           Foreground="{StaticResource Fg.Secondary}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
