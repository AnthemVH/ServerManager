<Window x:Class="ServerLauncher.App.Views.PairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pair a phone"
        Height="640" Width="470"
        Background="{StaticResource Bg.Window}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="22,18,22,10">
            <StackPanel>
                <TextBlock Text="Scan this with the ServerManager app"
                           FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14"
                           Text="The code works once and expires in five minutes. Nothing can pair while this window is closed." />

                <!-- Rendered from the QR modules rather than an image file. -->
                <Border Background="White" Padding="12" HorizontalAlignment="Center"
                        CornerRadius="4">
                    <Image x:Name="QrImage" Width="260" Height="260"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Border>

                <TextBlock Text="Or enter these by hand" Style="{StaticResource Label}" Margin="0,18,0,4" />

                <Border Background="{StaticResource Bg.Panel}" CornerRadius="4" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="Address" Style="{StaticResource Label}" Margin="0,0,0,2" />
                        <TextBox x:Name="AddressBox" IsReadOnly="True"
                                 FontFamily="{StaticResource Font.Mono}" FontSize="12" />

                        <TextBlock Text="Pairing code" Style="{StaticResource Label}" />
                        <TextBox x:Name="CodeBox" IsReadOnly="True"
                                 FontFamily="{StaticResource Font.Mono}" FontSize="20"
                                 FontWeight="Bold" Padding="8,6" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="CountdownText" Style="{StaticResource Hint}" Margin="0,10,0,0" />

                <Border x:Name="WarningPanel" Background="{StaticResource Danger}" CornerRadius="4"
                        Padding="12,10" Margin="0,12,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="WarningText" TextWrapping="Wrap" FontSize="12" />
                </Border>

                <TextBlock Style="{StaticResource Hint}" Margin="0,14,0,0"
                           Text="A newly paired phone can view your servers, start and stop them, and read their consoles. Sending console commands is granted separately, per device, in Settings." />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{StaticResource Bg.Panel}"
                BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,1,0,0"
                Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="New code" Style="{StaticResource ToolButton}" Click="OnNewCode" />
                <Button Content="Done" Style="{StaticResource PrimaryButton}" Click="OnClose" Margin="0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
