<Window x:Class="ServerLauncher.App.Views.ScheduleEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ServerLauncher.App.ViewModels"
        Title="Schedule entry"
        Width="480" SizeToContent="Height"
        ResizeMode="NoResize"
        Background="{StaticResource Bg.Window}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="20,14,20,16">

            <TextBlock Text="Server" Style="{StaticResource Label}" Margin="0,0,0,4" />
            <ComboBox x:Name="ServerBox" DisplayMemberPath="Name"
                      SelectionChanged="OnServerChanged" />

            <TextBlock Text="What to do" Style="{StaticResource Label}" />
            <ComboBox x:Name="ActionBox"
                      ItemsSource="{Binding Source={x:Static vm:ScheduleRow.ActionChoices}}"
                      DisplayMemberPath="Label"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding Action, Mode=TwoWay}"
                      SelectionChanged="OnFieldChanged" />

            <TextBlock Text="Time (24-hour, HH:mm)" Style="{StaticResource Label}" />
            <TextBox x:Name="TimeBox" Width="90" HorizontalAlignment="Left"
                     Text="{Binding Time, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="{StaticResource Font.Mono}" FontSize="12.5"
                     TextChanged="OnFieldChanged" />

            <TextBlock Text="Days" Style="{StaticResource Label}" />
            <WrapPanel>
                <CheckBox Content="Mon" IsChecked="{Binding Monday, Mode=TwoWay}" Margin="0,0,12,0" Click="OnFieldChanged" />
                <CheckBox Content="Tue" IsChecked="{Binding Tuesday, Mode=TwoWay}" Margin="0,0,12,0" Click="OnFieldChanged" />
                <CheckBox Content="Wed" IsChecked="{Binding Wednesday, Mode=TwoWay}" Margin="0,0,12,0" Click="OnFieldChanged" />
                <CheckBox Content="Thu" IsChecked="{Binding Thursday, Mode=TwoWay}" Margin="0,0,12,0" Click="OnFieldChanged" />
                <CheckBox Content="Fri" IsChecked="{Binding Friday, Mode=TwoWay}" Margin="0,0,12,0" Click="OnFieldChanged" />
                <CheckBox Content="Sat" IsChecked="{Binding Saturday, Mode=TwoWay}" Margin="0,0,12,0" Click="OnFieldChanged" />
                <CheckBox Content="Sun" IsChecked="{Binding Sunday, Mode=TwoWay}" Click="OnFieldChanged" />
            </WrapPanel>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Every day" Style="{StaticResource ToolButton}" Padding="10,3" FontSize="11"
                        Tag="EveryDay" Click="OnDayPreset" />
                <Button Content="Weekdays" Style="{StaticResource ToolButton}" Padding="10,3" FontSize="11"
                        Tag="Weekdays" Click="OnDayPreset" />
                <Button Content="Weekends" Style="{StaticResource ToolButton}" Padding="10,3" FontSize="11"
                        Tag="Weekend" Click="OnDayPreset" />
                <Button Content="Clear" Style="{StaticResource ToolButton}" Padding="10,3" FontSize="11"
                        Tag="None" Click="OnDayPreset" Margin="0" />
            </StackPanel>

            <CheckBox Content="Enabled" IsChecked="{Binding Enabled, Mode=TwoWay}" Margin="0,14,0,0"
                      ToolTip="Untick to pause this entry without deleting it" />

            <Border Background="{StaticResource Bg.Panel}" CornerRadius="4" Padding="10,8" Margin="0,14,0,0"
                    BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1">
                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource Bg.Panel}"
                BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,1,0,0"
                Padding="16,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancel" Style="{StaticResource ToolButton}" Click="OnCancel" IsCancel="True" />
                    <Button Content="Save" Style="{StaticResource PrimaryButton}" Click="OnSave" Margin="0" IsDefault="True" />
                </StackPanel>
                <TextBlock x:Name="ValidationText" Foreground="#F48771" VerticalAlignment="Center"
                           TextWrapping="Wrap" Margin="0,0,12,0" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
