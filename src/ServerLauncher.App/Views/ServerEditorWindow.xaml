<Window x:Class="ServerLauncher.App.Views.ServerEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ServerLauncher.App.ViewModels"
        Title="Server settings"
        Height="720" Width="620"
        MinHeight="500" MinWidth="520"
        Background="{StaticResource Bg.Window}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="20,10,20,10">
            <StackPanel>

                <TextBlock Text="Server" Style="{StaticResource SectionHeading}" Margin="0,6,0,4" />

                <TextBlock Text="Name" Style="{StaticResource Label}" />
                <TextBox x:Name="NameBox" />

                <TextBlock Text="Start script" Style="{StaticResource Label}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ScriptBox" Grid.Column="0" FontFamily="{StaticResource Font.Mono}" FontSize="11.5" />
                    <Button Grid.Column="1" Content="Browse…" Style="{StaticResource ToolButton}"
                            Click="OnBrowseScript" Margin="6,0,0,0" Padding="10,4" />
                </Grid>
                <TextBlock Style="{StaticResource Hint}"
                           Text="A .bat, .cmd, .ps1 or .exe. The file is never modified." />

                <TextBlock Text="Working directory" Style="{StaticResource Label}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="WorkingDirBox" Grid.Column="0" FontFamily="{StaticResource Font.Mono}" FontSize="11.5" />
                    <Button Grid.Column="1" Content="Browse…" Style="{StaticResource ToolButton}"
                            Click="OnBrowseWorkingDir" Margin="6,0,0,0" Padding="10,4" />
                </Grid>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Leave empty to run from the script's own folder, which is what most server scripts expect." />

                <TextBlock Text="Extra arguments" Style="{StaticResource Label}" />
                <TextBox x:Name="ArgumentsBox" FontFamily="{StaticResource Font.Mono}" FontSize="11.5" />

                <TextBlock Text="Environment variables" Style="{StaticResource Label}" />
                <TextBox x:Name="EnvironmentBox"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Height="80"
                         FontFamily="{StaticResource Font.Mono}" FontSize="11.5" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="One KEY=VALUE per line, applied on top of the inherited environment — for example JAVA_OPTS=-Xmx4G. Lines starting with # are ignored." />

                <CheckBox x:Name="AutoStartBox" Content="Start this server when the launcher starts" Margin="0,14,0,0" />

                <!-- Shutdown -->
                <TextBlock Text="Shutdown" Style="{StaticResource SectionHeading}" />

                <TextBlock Text="Stop command" Style="{StaticResource Label}" />
                <TextBox x:Name="StopCommandBox" FontFamily="{StaticResource Font.Mono}" FontSize="11.5" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Written to the server's console to request a clean shutdown — for example 'stop' for Minecraft or 'quit' for many source engine servers. Leave empty if the server does not read commands; it will be terminated after a short grace period instead." />

                <TextBlock Text="Seconds to wait before force-stopping" Style="{StaticResource Label}" />
                <TextBox x:Name="GraceBox" Width="90" HorizontalAlignment="Left" />

                <!-- Supervision -->
                <TextBlock Text="Automatic restarts" Style="{StaticResource SectionHeading}" />

                <TextBlock Text="Restart policy" Style="{StaticResource Label}" />
                <ComboBox x:Name="RestartPolicyBox" Width="240" HorizontalAlignment="Left" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Never — leave it down. On crash — restart only after a non-zero exit. Always — restart on any exit. Stopping a server yourself never triggers a restart." />

                <TextBlock Text="Exit codes that mean a clean stop" Style="{StaticResource Label}" />
                <TextBox x:Name="CleanExitCodesBox" Width="240" HorizontalAlignment="Left"
                         FontFamily="{StaticResource Font.Mono}" FontSize="11.5" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Comma separated. Code 0 and the standard Windows codes for closing a window or pressing Ctrl+C are always treated as a clean stop, so closing a server yourself never triggers a restart. Add codes here if your server reports its own on shutdown." />

                <TextBlock Text="Give up after this many failures in a row" Style="{StaticResource Label}" />
                <TextBox x:Name="MaxRestartsBox" Width="90" HorizontalAlignment="Left" />

                <TextBlock Text="Minutes of uptime that count as stable" Style="{StaticResource Label}" />
                <TextBox x:Name="StableMinutesBox" Width="90" HorizontalAlignment="Left" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Once the server has been up this long, its failure count resets — so a server that crashes once a week never accumulates its way into being given up on." />

                <!-- Update script -->
                <TextBlock Text="Update script" Style="{StaticResource SectionHeading}" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                           Text="A second script that updates the server or its mods — a SteamCMD batch file, a mod sync, anything that has to run before the server comes up. It never runs on its own: only when you press Run update, when a schedule entry says so, or before every start if you tick the box below." />

                <TextBlock Text="Script to run" Style="{StaticResource Label}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="UpdateScriptBox" Grid.Column="0" FontFamily="{StaticResource Font.Mono}" FontSize="11.5" />
                    <Button Grid.Column="1" Content="Browse…" Style="{StaticResource ToolButton}"
                            Click="OnBrowseUpdateScript" Margin="6,0,0,0" Padding="10,4" />
                </Grid>
                <TextBlock Style="{StaticResource Hint}"
                           Text="A .bat, .cmd, .ps1 or .exe, run from the same working directory as the server. Its output appears in this server's console." />

                <TextBlock Text="Extra arguments" Style="{StaticResource Label}" />
                <TextBox x:Name="UpdateArgumentsBox" FontFamily="{StaticResource Font.Mono}" FontSize="11.5" />

                <TextBlock Text="Give up after this many minutes" Style="{StaticResource Label}" />
                <TextBox x:Name="UpdateTimeoutBox" Width="90" HorizontalAlignment="Left" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="An update that hangs would otherwise keep a stopped server stopped indefinitely. The whole update process tree is stopped when this runs out." />

                <CheckBox x:Name="RunUpdateBeforeStartBox" Margin="0,12,0,0"
                          Content="Run the update script every time this server starts" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Off by default, because an update that downloads from the network turns a fast restart into a slow one. A failed update never stops the server starting." />

                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                           Text="Running an update while the server is up stops it first, because a mod updater cannot overwrite files the server holds open. It is started again afterwards, whether or not the update succeeded." />

                <!-- Schedule -->
                <TextBlock Text="Schedule" Style="{StaticResource SectionHeading}" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                           Text="Times this server starts, stops, restarts, updates or backs itself up. Each entry runs on the days you tick, so twice a week is one entry with two days ticked — not two entries." />

                <ItemsControl x:Name="ScheduleList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Bg.Panel}" CornerRadius="4" Padding="10,8"
                                    Margin="0,0,0,6" BorderBrush="{StaticResource Border.Subtle}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                  VerticalAlignment="Center" Margin="0,0,8,0"
                                                  ToolTip="Untick to keep this entry without running it" />

                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding Source={x:Static vm:ScheduleRow.ActionChoices}}"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding Action, Mode=TwoWay}"
                                                  HorizontalAlignment="Left" Width="190" Margin="0" />

                                        <TextBox Grid.Column="2" Width="70" Margin="8,0,0,0"
                                                 Text="{Binding Time, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="{StaticResource Font.Mono}" FontSize="11.5"
                                                 ToolTip="Time of day as HH:mm on a 24-hour clock" />

                                        <Button Grid.Column="3" Content="Remove" Style="{StaticResource DangerButton}"
                                                Padding="10,3" FontSize="11" Margin="8,0,0,0"
                                                Tag="{Binding Id}" Click="OnRemoveScheduleEntry" />
                                    </Grid>

                                    <WrapPanel Margin="0,8,0,0">
                                        <CheckBox Content="Mon" IsChecked="{Binding Monday, Mode=TwoWay}" Margin="0,0,10,0" />
                                        <CheckBox Content="Tue" IsChecked="{Binding Tuesday, Mode=TwoWay}" Margin="0,0,10,0" />
                                        <CheckBox Content="Wed" IsChecked="{Binding Wednesday, Mode=TwoWay}" Margin="0,0,10,0" />
                                        <CheckBox Content="Thu" IsChecked="{Binding Thursday, Mode=TwoWay}" Margin="0,0,10,0" />
                                        <CheckBox Content="Fri" IsChecked="{Binding Friday, Mode=TwoWay}" Margin="0,0,10,0" />
                                        <CheckBox Content="Sat" IsChecked="{Binding Saturday, Mode=TwoWay}" Margin="0,0,10,0" />
                                        <CheckBox Content="Sun" IsChecked="{Binding Sunday, Mode=TwoWay}" Margin="0,0,10,0" />
                                    </WrapPanel>

                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="NoScheduleText" Style="{StaticResource Hint}"
                           Text="Nothing scheduled. This server starts and stops only when you say so." />

                <Button Content="Add schedule entry" Style="{StaticResource ToolButton}"
                        HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,5"
                        Click="OnAddScheduleEntry" />

                <!-- Backups -->
                <TextBlock Text="Backups" Style="{StaticResource SectionHeading}" />

                <CheckBox x:Name="BackupEnabledBox" Content="Run scheduled backups for this server" />

                <TextBlock Text="Folder to back up" Style="{StaticResource Label}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="BackupSourceBox" Grid.Column="0" FontFamily="{StaticResource Font.Mono}" FontSize="11.5" />
                    <Button Grid.Column="1" Content="Browse…" Style="{StaticResource ToolButton}"
                            Click="OnBrowseBackupSource" Margin="6,0,0,0" Padding="10,4" />
                </Grid>
                <TextBlock Style="{StaticResource Hint}" Text="Leave empty to back up the working directory." />

                <TextBlock Text="Where to put the archives" Style="{StaticResource Label}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="BackupDestBox" Grid.Column="0" FontFamily="{StaticResource Font.Mono}" FontSize="11.5" />
                    <Button Grid.Column="1" Content="Browse…" Style="{StaticResource ToolButton}"
                            Click="OnBrowseBackupDest" Margin="6,0,0,0" Padding="10,4" />
                </Grid>

                <TextBlock Text="Backup mode" Style="{StaticResource Label}" />
                <ComboBox x:Name="BackupModeBox" Width="300" HorizontalAlignment="Left" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Safe stops the server, archives it, then restarts it — always restorable, with a short outage. Live archives while running and skips files the server holds locked, which is faster but may capture a world mid-save." />

                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                           Text="To run backups automatically, add a 'Back up' entry under Schedule above." />

                <TextBlock Text="Archives to keep" Style="{StaticResource Label}" />
                <TextBox x:Name="RetentionBox" Width="90" HorizontalAlignment="Left" />
                <TextBlock Style="{StaticResource Hint}" Text="Older archives are deleted after each successful backup." Margin="0,3,0,10" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{StaticResource Bg.Panel}"
                BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,1,0,0"
                Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="ValidationText" Foreground="#F48771" VerticalAlignment="Center"
                           Margin="0,0,14,0" TextWrapping="Wrap" MaxWidth="320" />
                <Button Content="Cancel" Style="{StaticResource ToolButton}" Click="OnCancel" />
                <Button Content="Save" Style="{StaticResource PrimaryButton}" Click="OnSave" Margin="0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
