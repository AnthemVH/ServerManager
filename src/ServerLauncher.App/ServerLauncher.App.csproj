<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ServerLauncher.Core\ServerLauncher.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.0.124" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <!-- Ships as ServerLauncher.exe; the project keeps its own name. -->
    <AssemblyName>ServerLauncher</AssemblyName>
    <AssemblyTitle>Server Launcher</AssemblyTitle>
    <Product>Server Launcher</Product>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets/app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Stamped so the running build knows which release asset it should update itself
         with. A standalone build must not replace itself with one that needs runtimes
         installed, and vice versa. -->
    <AssemblyMetadata Include="SelfContained" Value="$(SelfContained)" />
  </ItemGroup>

</Project>
